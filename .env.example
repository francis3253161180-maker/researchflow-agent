RESEARCHFLOW_DB_PATH=./data/researchflow.db
# Optional: when configured, the service protects /api/* with X-API-Key.
RESEARCHFLOW_APP_API_KEY=
RESEARCHFLOW_MAX_UPLOAD_BYTES=15728640

# LLM: a DEEPSEEK_API_KEY automatically uses https://api.deepseek.com and deepseek-v4-flash.
DEEPSEEK_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# DeepSeek V4 supports enabled/disabled. Keep RAG generation non-thinking by default.
LLM_THINKING=disabled

# Optional second-stage multilingual *chunk* reranking.
# auto: eagerly starts on CUDA; a CPU user can start it manually from the UI.
# bge: eagerly starts on the configured device (CPU or CUDA). none: force-off.
RERANKER_PROVIDER=auto
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_CACHE_DIR=./data/models
RERANKER_DEVICE=auto
RERANKER_CANDIDATES=20

# Number of grounded evidence chunks given to RAG generation (1-8). Six keeps
# multi-part questions covered without turning every answer into a whole-document dump.
RETRIEVAL_TOP_K=6

# Retrieval: `hash` is offline and deterministic but has no semantic or cross-lingual capability.
# `fastembed` runs a multilingual CPU ONNX model; re-import documents after changing providers/models.
EMBEDDING_PROVIDER=hash
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=./data/models
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional web search through an external MCP Server. Disabled by default, so
# local document RAG remains fully offline. Tavily's local MCP needs Node.js and
# a TAVILY_API_KEY; never commit the key.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_MCP_COMMAND=npx
WEB_SEARCH_MCP_ARGS=["-y", "tavily-mcp@latest"]
WEB_SEARCH_MCP_TOOL=tavily-search
WEB_SEARCH_MAX_RESULTS=5
TAVILY_API_KEY=
