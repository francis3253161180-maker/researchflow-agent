RESEARCHFLOW_DB_PATH=./data/researchflow.db
# Optional: when configured, the service protects /api/* with X-API-Key.
RESEARCHFLOW_APP_API_KEY=
RESEARCHFLOW_MAX_UPLOAD_BYTES=15728640

# LLM: a DEEPSEEK_API_KEY automatically uses https://api.deepseek.com and deepseek-v4-flash.
DEEPSEEK_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# DeepSeek V4 supports enabled/disabled. Keep RAG generation non-thinking by default.
LLM_THINKING=disabled

# Retrieval: `hash` is offline and deterministic but has no semantic or cross-lingual capability.
# `fastembed` runs a multilingual CPU ONNX model; re-import documents after changing providers/models.
EMBEDDING_PROVIDER=hash
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
FASTEMBED_CACHE_DIR=./data/models
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
